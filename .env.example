# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# Spotify app at developer.spotify.com; refresh token from scripts/spotify-token.mjs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# "npsso" cookie value from https://ca.account.sony.com/api/v1/ssocookie while logged in
PSN_NPSSO=
